# Production-Grade Development Environment
# Optimized for testing production-like configurations locally
# JSON logging, INFO level, minimal output

PORT=3000
NODE_ENV=development

# Better Auth Configuration
BETTER_AUTH_SECRET=abcdefghijklmnopqrstuvwxyz123456
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wave_db

# Kafka Configuration
KAFKA_BROKER_URL=localhost:9092

# Email Configuration (MailHog for development)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test
EMAIL_FROM=noreply@wallet.app

# Logging Configuration (Production-style)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PRETTY=false

# Monitoring Configuration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Health Check Configuration
HEALTH_CHECK_ENABLED=true

# Observability
JAEGER_ENABLED=false
TRACING_ENABLED=false

# Feature Flags
DEBUG_MODE=false
VERBOSE_LOGGING=false
