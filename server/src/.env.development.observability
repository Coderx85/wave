# Observability Development Environment
# Optimized for debugging and monitoring
# Pretty-printed logs, DEBUG level, all metrics enabled

PORT=3000
NODE_ENV=development

# Better Auth Configuration
BETTER_AUTH_SECRET=abcdefghijklmnopqrstuvwxyz123456
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wave_db

# Kafka Configuration
KAFKA_BROKER_URL=localhost:9092

# Email Configuration (MailHog for development)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test
EMAIL_FROM=noreply@wallet.app

# Logging Configuration (Debug-friendly)
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_PRETTY=true

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Health Check Configuration
HEALTH_CHECK_ENABLED=true

# Observability & Tracing
JAEGER_ENABLED=true
JAEGER_HOST=localhost
JAEGER_PORT=6831
TRACING_ENABLED=true

# Feature Flags (All enabled for debugging)
DEBUG_MODE=true
VERBOSE_LOGGING=true
REQUEST_LOGGING=true
RESPONSE_LOGGING=true

# Performance Monitoring
SLOW_QUERY_LOGGING=true
SLOW_QUERY_THRESHOLD_MS=100
