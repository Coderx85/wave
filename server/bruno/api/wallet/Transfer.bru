meta {
  name: Transfer
  type: http
  seq: 7
}

post {
  url: http://localhost:3000/api/transfers
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{userId}}",
    "senderAccountId": "{{senderAccountId}}",
    "senderName": "Sender Name",
    "receiverAccountId": "{{receiverAccountId}}",
    "receiverName": "Receiver Name",
    "amount": 50
  }
}
